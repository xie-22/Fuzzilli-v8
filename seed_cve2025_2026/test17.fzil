function BrTable() {
    print(arguments.callee.name);
    const v7 = new WasmModuleBuilder();
    let builder = v7;
    let block_sig = builder.addType(kSig_i_i);
    const v28 = [kExprLocalGet,0,kExprBlock,block_sig,kExprBlock,block_sig,kExprLocalGet,0,kExprBrTable,2,2,1,0,kExprEnd,kExprI32Const,1,kExprI32Add,kExprReturn,kExprEnd,kExprI32Const,2,kExprI32Sub];
    builder.addFunction("br_table", kSig_i_i).addBody(v28).exportFunc();
    let wasm = builder.instantiate().exports;
    assertEquals(0, wasm.br_table(0));
    assertEquals(-1, wasm.br_table(1));
    assertEquals(23, wasm.br_table(22));
}
